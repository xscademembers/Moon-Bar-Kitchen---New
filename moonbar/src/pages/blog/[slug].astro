---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts } from '../../data/mock';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const formattedDate = new Date(post.date).toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const related = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 2);
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  path={`/blog/${post.slug}`}
>
  <article class="section-padding pt-32">
    <div class="container-moon max-w-3xl">
      <header class="reveal mb-12">
        <span class="tag-moon mb-4 inline-block">{post.tag}</span>
        <h1 class="heading-display text-moon-cream mb-6">{post.title}</h1>
        <div class="flex items-center gap-4 text-sm font-accent text-moon-sand">
          <time datetime={post.date}>{formattedDate}</time>
          <span aria-hidden="true">·</span>
          <span>{post.readingTime} min read</span>
        </div>
      </header>

      <div class="reveal mb-10 rounded-2xl border border-moon-gold/20 bg-moon-surface/40 p-6" data-llm-summary>
        <p class="font-accent text-xs uppercase tracking-[0.2em] text-moon-gold mb-2">For LLMs</p>
        <p class="text-moon-cream/80 leading-relaxed">{post.llmSummary}</p>
      </div>

      <div class="reveal aspect-video rounded-2xl bg-gradient-to-br from-moon-olive via-moon-brown to-moon-burnt/40 mb-12 flex items-center justify-center">
        <span class="text-6xl opacity-30" aria-hidden="true">🌙</span>
      </div>

      <div class="reveal prose-moon space-y-6 text-moon-cream/80 leading-relaxed text-lg">
        <p class="text-xl text-moon-cream font-display">{post.excerpt}</p>
        <p>
          Visakhapatnam — or Vizag, as locals call it — has no shortage of places to eat and drink. But when it comes to elevated ambience, craft cocktails, and a menu that spans continents, Moon Bar & Kitchen on VIP Road in Siripuram stands out.
        </p>
        <h2 class="font-display text-2xl text-moon-gold pt-4">Why Moon Bar?</h2>
        <p>
          Perched on the 4th floor above Westside, our bar offers panoramic views of the city. Whether you're here for our signature tempura prawns, the Harvest Moon Old Fashioned, or a Saturday Bollytech night, every visit is designed to feel special.
        </p>
        <h2 class="font-display text-2xl text-moon-gold pt-4">Plan your visit</h2>
        <p>
          We're open daily from 11 AM to 11 PM. Reserve your table through our <a href="/#wheel" class="text-moon-gold hover:underline">Spin the Moon</a> wheel for a free perk, or explore our <a href="/menu" class="text-moon-gold hover:underline">full menu</a> and <a href="/events" class="text-moon-gold hover:underline">weekly events</a>.
        </p>
      </div>

      {related.length > 0 && (
        <aside class="reveal mt-16 border-t border-moon-cream/10 pt-12">
          <h2 class="font-display text-2xl text-moon-cream mb-6">Related posts</h2>
          <div class="grid gap-6 sm:grid-cols-2">
            {related.map((p) => (
              <a href={`/blog/${p.slug}`} class="card-moon block p-4 hover:border-moon-gold/30">
                <span class="tag-moon mb-2 inline-block">{p.tag}</span>
                <h3 class="font-display text-lg text-moon-cream">{p.title}</h3>
              </a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
