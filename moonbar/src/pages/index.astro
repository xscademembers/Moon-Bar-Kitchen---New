---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NightSkySection from '../components/NightSkySection.astro';
import SpinWheel from '../components/SpinWheel';
import AboutStrip from '../components/AboutStrip.astro';
import MenuPreview from '../components/MenuPreview.astro';
import EventsGrid from '../components/EventsGrid.astro';
import BlogCard from '../components/BlogCard.astro';
import Gallery from '../components/Gallery.astro';
import VisitUs from '../components/VisitUs.astro';
import { blogPosts as allBlogPosts } from '../data/mock';

const blogPosts = allBlogPosts.slice(0, 3);
---

<BaseLayout
  title="Best Resto Bar in Vizag"
  description="Moon Bar & Kitchen — elevated resto-bar in Siripuram, Visakhapatnam. Spin the wheel for a free perk, reserve your table, and enjoy cocktails, live music & Sunday brunch."
  path="/"
>
  <!-- 1. Hero — Dark -->
  <Hero />

  <!-- Spin the Wheel — same night-sky + stars as hero -->
  <NightSkySection id="wheel" class="scroll-mt-20 px-4 py-28 sm:px-6 lg:px-8 lg:py-32">
    <div class="container-moon">
      <div class="reveal mb-12 text-center">
        <p class="font-accent text-xs uppercase tracking-[0.3em] text-moon-sand mb-3">Spin &amp; Win</p>
        <h2 class="heading-section text-moon-cream mb-4">Spin the Moon</h2>
        <p class="mx-auto max-w-lg text-[#F5E8D8]/80">
          Every reservation comes with a celestial perk. Give the wheel a spin and lock in your table.
        </p>
      </div>
      <div class="flex justify-center">
        <SpinWheel client:load />
      </div>
    </div>
  </NightSkySection>

  <!-- 2. About — Light Cream -->
  <AboutStrip />

  <!-- 3. Menu — Dark Olive -->
  <MenuPreview />

  <!-- 4. Events — Warm Orange Gradient -->
  <EventsGrid />

  <!-- 5. Blog / Guides — Light Cream (testimonials-style) -->
  <section class="section-padding bg-moon-cream">
    <div class="container-moon">
      <div class="reveal mb-12 flex flex-col items-center justify-between gap-4 sm:flex-row">
        <div>
          <p class="font-accent text-xs uppercase tracking-[0.3em] text-moon-sand mb-3 flex items-center gap-2">
            <span class="inline-block h-px w-8 bg-moon-sand" aria-hidden="true"></span>
            From the Blog
          </p>
          <h2 class="heading-section text-moon-olive">Vizag eats &amp; bar guides</h2>
        </div>
        <a href="/blog" class="btn-olive">All posts</a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {blogPosts.map((post) => (
          <BlogCard {...post} variant="light" priority />
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Gallery — Pure Dark -->
  <Gallery />

  <!-- 7. Contact / Visit — Olive -->
  <VisitUs />
</BaseLayout>
