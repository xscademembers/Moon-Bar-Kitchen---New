---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Moon Bar & Kitchen — an elevated resto-bar in Siripuram, Visakhapatnam. Multi-cuisine dining, craft cocktails, live music and the best views in Vizag."
  path="/about"
>
  <section class="section-padding pt-32">
    <div class="container-moon max-w-4xl">
      <div class="reveal mb-16 text-center">
        <p class="font-accent text-xs uppercase tracking-[0.3em] text-moon-sand mb-3">Our Story</p>
        <h1 class="heading-display text-moon-cream mb-6">Above the city,<br /><em class="text-gradient-gold not-italic">under the moon.</em></h1>
      </div>

      <div class="reveal space-y-8 text-moon-cream/75 leading-relaxed text-lg">
        <p>
          Moon Bar & Kitchen sits on the 4th floor above Westside on VIP Road — an elevated escape in the heart of Siripuram, Visakhapatnam. We opened with a simple idea: create a space where the food is as memorable as the view, and every night feels like it was written in the stars.
        </p>
        <p>
          Our kitchen draws from Indian, Continental, and Asian traditions — think crispy tempura prawns, Andhra-spiced wings, truffle mushroom risotto, and a full bar of craft cocktails. The <strong class="text-moon-gold">Harvest Moon Old Fashioned</strong> has become a Vizag favourite.
        </p>
        <p>
          Upstairs, the bar comes alive. Live bands every Wednesday and Sunday evening. House music on Fridays. Bollytech on Saturdays — Bollywood meets tech house. And on Sunday afternoons, our brunch buffet with bottomless mimosas.
        </p>
      </div>

      <div class="reveal mt-16 grid gap-8 sm:grid-cols-3">
        {[
          { stat: '4th Floor', label: 'Above Westside, VIP Road' },
          { stat: '11 AM – 11 PM', label: 'Open daily, all week' },
          { stat: '5 Nights', label: 'Live music & DJ events weekly' },
        ].map(({ stat, label }) => (
          <div class="card-moon p-6 text-center">
            <p class="font-display text-2xl text-moon-gold mb-2">{stat}</p>
            <p class="text-sm text-moon-cream/60">{label}</p>
          </div>
        ))}
      </div>

      <div class="reveal mt-16 text-center">
        <a href="/#wheel" class="btn-primary">Reserve your table</a>
      </div>
    </div>
  </section>
</BaseLayout>
