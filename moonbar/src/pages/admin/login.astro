---
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Login | Moon Bar</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-[#1a1a1a] p-4">
    <div class="w-full max-w-md rounded-2xl border border-[#f9e1cd]/10 bg-[#222] p-8">
      <div class="mb-8 text-center">
        <span class="text-4xl">🌙</span>
        <h1 class="mt-4 font-serif text-2xl text-[#ffda7f]">Moon Bar Admin</h1>
        <p class="mt-2 text-sm text-[#f9e1cd]/80">Sign in to manage reservations, gallery & blog</p>
      </div>

      <form id="login-form" class="space-y-4">
        <div>
          <label for="username" class="mb-1 block text-xs uppercase tracking-wider text-[#e7a356]">Username</label>
          <input
            id="username"
            name="username"
            type="text"
            required
            autocomplete="username"
            class="w-full rounded-lg border border-[#f9e1cd]/20 bg-[#1a1a1a] px-4 py-2.5 text-[#f9e1cd] focus:border-[#ffda7f] focus:outline-none"
          />
        </div>
        <div>
          <label for="password" class="mb-1 block text-xs uppercase tracking-wider text-[#e7a356]">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full rounded-lg border border-[#f9e1cd]/20 bg-[#1a1a1a] px-4 py-2.5 text-[#f9e1cd] focus:border-[#ffda7f] focus:outline-none"
          />
        </div>
        <p id="login-error" class="hidden text-sm text-red-400"></p>
        <button
          type="submit"
          class="w-full rounded-full bg-[#ffda7f] py-3 text-sm font-semibold text-[#1b1b1b] hover:bg-[#e7a356] transition-colors"
        >
          Sign in
        </button>
      </form>
    </div>

    <script>
      const form = document.getElementById('login-form') as HTMLFormElement;
      const errorEl = document.getElementById('login-error') as HTMLParagraphElement;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');
        const fd = new FormData(form);
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            username: fd.get('username'),
            password: fd.get('password'),
          }),
        });
        if (res.ok) {
          window.location.href = '/admin';
        } else {
          const data = await res.json();
          errorEl.textContent = data.error || 'Login failed';
          errorEl.classList.remove('hidden');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../../styles/global.css';
</style>
