---
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  tag: string;
  date: string;
  readingTime: number;
  imageUrl?: string;
  variant?: 'dark' | 'light';
  priority?: boolean;
}

const { slug, title, excerpt, tag, date, readingTime, imageUrl, variant = 'dark', priority = false } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isLight = variant === 'light';
---

<article class:list={['group flex flex-col overflow-hidden h-full', isLight ? 'card-testimonial' : 'card-moon']}>
  <div class="h-40 relative overflow-hidden shrink-0">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt=""
        class="h-full w-full object-cover"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="h-full bg-gradient-to-br from-moon-olive via-moon-brown to-moon-burnt/40">
        <div class="absolute inset-0 flex items-center justify-center text-5xl opacity-30" aria-hidden="true">🌙</div>
      </div>
    )}
    <div class="absolute bottom-3 left-4">
      <span class="tag-moon">{tag}</span>
    </div>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex items-center gap-3 text-xs font-accent text-moon-sand">
      <time datetime={date}>{formattedDate}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime} min read</span>
    </div>
    <h3 class:list={[
      'font-display text-xl transition-colors mb-3',
      isLight ? 'text-moon-olive group-hover:text-moon-rust' : 'text-moon-cream group-hover:text-moon-gold',
    ]}>
      <a href={`/blog/${slug}`}>{title}</a>
    </h3>
    <p class:list={[
      'text-sm leading-relaxed flex-1',
      isLight ? 'text-moon-olive/70' : 'text-moon-cream/60',
    ]}>{excerpt}</p>
    <a
      href={`/blog/${slug}`}
      class:list={[
        'mt-4 font-accent text-xs uppercase tracking-wider hover:underline',
        isLight ? 'text-moon-olive' : 'text-moon-gold',
      ]}
    >
      Read more →
    </a>
  </div>
</article>
