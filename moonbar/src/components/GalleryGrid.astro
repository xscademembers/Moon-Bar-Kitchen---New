---
import { galleryItems, type GalleryItem } from '../data/gallery';

type GridItem = GalleryItem & { imageUrl?: string };

interface Props {
  items?: GridItem[];
  showFilters?: boolean;
  heading?: boolean;
}

const {
  items = galleryItems,
  showFilters = false,
  heading = true,
} = Astro.props;

const categories = [
  { slug: 'all', label: 'All' },
  { slug: 'ambience', label: 'Ambience' },
  { slug: 'food', label: 'Food' },
  { slug: 'drinks', label: 'Drinks' },
  { slug: 'events', label: 'Events' },
];
---

<div>
  {heading && (
    <div class="reveal mb-12 text-center">
      <p class="font-accent text-xs uppercase tracking-[0.3em] text-moon-sand mb-3">The Experience</p>
      <h2 class="heading-section text-moon-olive">Moments under the moon.</h2>
    </div>
  )}

  {showFilters && (
    <div class="reveal mb-10 flex flex-wrap justify-center gap-2" id="gallery-filters" role="tablist" aria-label="Gallery categories">
      {categories.map(({ slug, label }) => (
        <button
          type="button"
          role="tab"
          data-filter={slug}
          class:list={[
            'rounded-full px-4 py-2.5 min-h-[44px] text-xs font-accent uppercase tracking-wider transition-all sm:px-5 sm:text-sm',
            slug === 'all'
              ? 'bg-moon-gold text-moon-dark'
              : 'border border-moon-olive/20 text-moon-olive/80 hover:border-moon-gold hover:text-moon-rust',
          ]}
          aria-selected={slug === 'all'}
        >
          {label}
        </button>
      ))}
    </div>
  )}

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" id="gallery-grid">
    {items.map((item, i) => (
      <div
        class="card-gallery group aspect-[4/3] w-full"
        data-category={item.category}
      >
        <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
          {item.imageUrl ? (
            <img
              src={item.imageUrl}
              alt={item.category}
              class="h-full w-full object-cover"
              loading={i < 6 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : (
            <div class="h-full w-full bg-gradient-to-br from-moon-olive/60 via-moon-brown/40 to-moon-rust/30"></div>
          )}
        </div>
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center">
          {!item.imageUrl && (
            <span class="text-4xl transition-transform duration-300 group-hover:scale-110" aria-hidden="true">{item.emoji}</span>
          )}
        </div>
        <div
          class="absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          style="background: rgba(65, 76, 47, 0.8);"
          aria-hidden="true"
        ></div>
        <span class="tag-moon absolute bottom-3 left-1/2 z-10 -translate-x-1/2 capitalize opacity-90 sm:bottom-4 sm:scale-95 sm:opacity-0 sm:transition-all sm:duration-300 sm:group-hover:scale-100 sm:group-hover:opacity-100">
          {item.category}
        </span>
      </div>
    ))}
  </div>
</div>

{showFilters && (
  <script>
    const filters = document.querySelectorAll('#gallery-filters [data-filter]');
    const grid = document.getElementById('gallery-grid');
    const items = grid?.querySelectorAll('[data-category]');

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        filters.forEach((b) => {
          const active = b === btn;
          b.setAttribute('aria-selected', String(active));
          b.classList.toggle('bg-moon-gold', active);
          b.classList.toggle('text-moon-dark', active);
          b.classList.toggle('border', !active);
          b.classList.toggle('border-moon-olive/20', !active);
          b.classList.toggle('text-moon-olive/80', !active);
        });

        items?.forEach((item) => {
          const cat = item.getAttribute('data-category');
          const show = filter === 'all' || cat === filter;
          item.classList.toggle('hidden', !show);
        });
      });
    });
  </script>
)}
