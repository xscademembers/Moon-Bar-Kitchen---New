---
import { sortEventsByWeekOrder, type WeeklyEvent } from '../lib/fetch-content';
import { weeklyEvents } from '../data/mock';

interface Props {
  events?: WeeklyEvent[];
}

const { events = weeklyEvents } = Astro.props;
const sortedEvents = sortEventsByWeekOrder(events);
---

<section class="section-padding bg-[#FAF8F4]">
  <div class="container-moon">
    <div class="reveal mb-12 text-center">
      <p
        class="font-accent text-xs uppercase mb-3"
        style="color: #BB5524; letter-spacing: 4px;"
      >
        This Week at Moon Bar
      </p>
      <h2 class="heading-section" style="color: #414C2F;">
        Every night has a soundtrack.
      </h2>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sortedEvents.map((event, i) => (
        <article
          class="reveal group overflow-hidden rounded-2xl transition-all duration-300 hover:border-[rgba(255,218,127,0.35)]"
          style={`
            background: #414C2F;
            border: 1px solid rgba(255,218,127,0.2);
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            transition-delay: ${i * 80}ms;
          `}
        >
          <div class="relative aspect-[4/5] overflow-hidden bg-[#2a3220]">
            {event.imageUrl ? (
              <img
                src={event.imageUrl}
                alt={event.title}
                class="h-full w-full object-contain object-center transition-transform duration-500 group-hover:scale-[1.02]"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ) : (
              <div
                class="h-full w-full"
                style={`background: linear-gradient(135deg, ${event.color}66, ${event.color}22);`}
              ></div>
            )}
          </div>

          <div class="p-6">
            <div class="mb-3 flex flex-wrap items-center gap-2 sm:justify-between">
              <span
                class="rounded-full px-3 py-1 text-xs font-accent uppercase tracking-wider"
                style="background: rgba(255,218,127,0.12); color: #FFDA7F;"
              >
                {event.day}
              </span>
              <time
                class="font-accent text-xs"
                style="color: rgba(249,225,205,0.85);"
              >
                {event.time}
              </time>
            </div>
            <h3
              class="font-display text-xl mb-2 transition-colors group-hover:text-[#FFDA7F]"
              style="color: #F9E1CD;"
            >
              {event.title}
            </h3>
            <p class="text-sm mb-3" style="color: rgba(249,225,205,0.85);">
              {event.artist}
            </p>
            <p class="text-sm leading-relaxed" style="color: rgba(249,225,205,0.85);">
              {event.description}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="reveal mt-10 text-center">
      <a
        href="/events"
        class="events-calendar-btn inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-medium transition-colors duration-300"
        style="background: #414C2F; color: #FFFFFF;"
      >
        Full Events Calendar
      </a>
    </div>
  </div>
</section>

<style>
  .events-calendar-btn:hover {
    background: #BB5524;
  }
</style>
