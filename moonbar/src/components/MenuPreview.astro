---
import { menuCategories } from '../data/mock';

const icons: Record<string, string> = {
  veg: '🥬',
  'non-veg': '🍤',
  beverages: '🍸',
};
---

<section class="section-padding">
  <div class="container-moon">
    <div class="reveal mb-12 text-center">
      <p class="font-accent text-xs uppercase tracking-[0.3em] text-moon-sand mb-3">Our Menu</p>
      <h2 class="heading-section text-moon-cream">Crafted for the cosmos.</h2>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {menuCategories.map((cat, i) => (
        <a
          href={`/menu#${cat.slug}`}
          class="reveal card-moon group block p-8 text-center"
          style={`transition-delay: ${i * 100}ms`}
        >
          <span class="text-4xl mb-4 block" aria-hidden="true">{icons[cat.slug]}</span>
          <h3 class="font-display text-2xl text-moon-cream group-hover:text-moon-gold transition-colors mb-2">
            {cat.name}
          </h3>
          <p class="text-sm text-moon-cream/60 mb-4">
            {cat.items.length} signature items
          </p>
          <span class="font-accent text-xs uppercase tracking-wider text-moon-gold group-hover:underline">
            View {cat.name} →
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
