---
import { menuCategories } from '../data/mock';

const icons: Record<string, string> = {
  veg: '🥬',
  'non-veg': '🍤',
  beverages: '🍸',
};
---

<section class="section-padding bg-moon-olive">
  <div class="container-moon">
    <div class="reveal mb-12 text-center">
      <p class="font-accent text-xs uppercase tracking-[0.3em] text-moon-sand mb-3">Our Menu</p>
      <h2 class="heading-section text-moon-cream">Crafted for the cosmos.</h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {menuCategories.map((cat, i) => (
        <a
          href={`/menu#${cat.slug}`}
          class="reveal card-menu group block p-6 text-center sm:p-8"
          style={`transition-delay: ${i * 100}ms`}
        >
          <span class="text-4xl mb-4 block" aria-hidden="true">{icons[cat.slug]}</span>
          <h3 class="font-display text-xl text-moon-cream group-hover:text-moon-gold transition-colors mb-2 sm:text-2xl">
            {cat.name}
          </h3>
          <p class="text-sm text-moon-gold mb-4 font-accent">
            {cat.items.length} signature items
          </p>
          <span class="inline-block rounded-full bg-moon-rust px-5 py-2 text-xs font-accent uppercase tracking-wider text-moon-cream group-hover:bg-moon-burnt transition-colors">
            View {cat.name} →
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
