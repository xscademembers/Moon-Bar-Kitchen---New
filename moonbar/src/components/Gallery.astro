---
import GalleryGrid from './GalleryGrid.astro';
import { fetchGalleryPreview } from '../lib/fetch-content';

const items = await fetchGalleryPreview(6);
---

<section class="section-padding bg-[#ffffff]">
  <div class="container-moon">
    <GalleryGrid items={items} />

    <div class="reveal mt-10 text-center">
      <a href="/gallery" class="btn-olive">View Full Gallery</a>
    </div>
  </div>
</section>
