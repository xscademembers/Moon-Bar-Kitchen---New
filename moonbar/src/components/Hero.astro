---
import Starfield from './Starfield';
---

<section class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden pt-20">
  <Starfield client:load />

  <!-- Moon -->
  <div
    class="pointer-events-none absolute right-[5%] top-[15%] h-48 w-48 rounded-full sm:h-64 sm:w-64 lg:h-80 lg:w-80 moon-glow opacity-90"
    aria-hidden="true"
    id="hero-moon"
  >
    <div class="absolute inset-0 rounded-full bg-gradient-to-br from-moon-gold via-moon-sand to-moon-rust/40"></div>
    <div class="absolute inset-[8%] rounded-full bg-gradient-to-br from-moon-gold/80 to-moon-sand/60 opacity-60"></div>
    <div class="absolute inset-[20%] rounded-full bg-moon-gold/20 blur-xl"></div>
    <!-- Craters -->
    <div class="absolute left-[25%] top-[30%] h-8 w-8 rounded-full bg-moon-brown/20 blur-[1px]"></div>
    <div class="absolute right-[20%] top-[45%] h-5 w-5 rounded-full bg-moon-brown/15"></div>
    <div class="absolute left-[40%] bottom-[25%] h-6 w-6 rounded-full bg-moon-brown/20"></div>
  </div>

  <div class="container-moon relative z-10 px-4 py-20 text-center sm:px-6 lg:px-8">
    <p class="reveal mb-4 font-accent text-xs uppercase tracking-[0.3em] text-moon-sand">
      Skyline Resto-Bar · Visakhapatnam
    </p>
    <h1 class="reveal heading-display text-balance text-moon-cream mb-6" style="transition-delay: 100ms">
      Make your night <em class="text-gradient-gold not-italic">written in the stars.</em>
    </h1>
    <p class="reveal mx-auto max-w-xl text-lg text-[#F5E8D8] mb-10" style="transition-delay: 200ms">
      Spin the moon. Claim your perk. Reserve your table.
    </p>
    <div class="reveal flex flex-col items-center gap-4 sm:flex-row sm:justify-center" style="transition-delay: 300ms">
      <a href="#wheel" class="btn-primary">Spin &amp; Reserve</a>
      <a href="/menu" class="btn-secondary">Explore the Menu</a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg class="h-6 w-6 text-moon-gold/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7" />
    </svg>
  </div>
</section>

<script>
  const moon = document.getElementById('hero-moon');
  if (moon && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      moon.style.transform = `translateY(${y * 0.15}px) translateX(${y * -0.05}px)`;
    });
  }
</script>
