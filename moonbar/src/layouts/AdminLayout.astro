---
interface Props {
  title: string;
}

const { title } = Astro.props;
const nav = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/reservations', label: 'Reservations' },
  { href: '/admin/menu', label: 'Menu' },
  { href: '/admin/gallery', label: 'Gallery' },
  { href: '/admin/blog', label: 'Blog' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Moon Bar Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#1a1a1a] text-[#f9e1cd] font-sans antialiased">
    <div class="flex min-h-screen">
      <aside class="hidden w-64 shrink-0 border-r border-[#f9e1cd]/10 bg-[#222] p-6 lg:block">
        <a href="/admin" class="mb-8 block font-serif text-xl text-[#ffda7f]">🌙 Moon Bar Admin</a>
        <nav class="space-y-1">
          {nav.map(({ href, label }) => (
            <a
              href={href}
              class:list={[
                'block rounded-lg px-4 py-2.5 text-sm transition-colors',
                current === href ? 'bg-[#414c2f] text-[#ffda7f]' : 'text-[#f9e1cd]/80 hover:bg-[#414c2f]/50',
              ]}
            >
              {label}
            </a>
          ))}
        </nav>
        <button
          type="button"
          id="admin-logout"
          class="mt-8 w-full rounded-lg border border-[#f9e1cd]/20 px-4 py-2 text-sm text-[#f9e1cd]/80 hover:border-[#ffda7f] hover:text-[#ffda7f]"
        >
          Log out
        </button>
      </aside>

      <div class="flex-1">
        <header class="flex items-center justify-between border-b border-[#f9e1cd]/10 bg-[#222] px-6 py-4 lg:hidden">
          <span class="font-serif text-lg text-[#ffda7f]">Admin</span>
          <button type="button" id="admin-logout-mobile" class="text-sm text-[#f9e1cd]/80">Log out</button>
        </header>
        <main class="p-6 lg:p-10">
          <slot />
        </main>
      </div>
    </div>

    <script>
      async function logout() {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      }
      document.getElementById('admin-logout')?.addEventListener('click', logout);
      document.getElementById('admin-logout-mobile')?.addEventListener('click', logout);
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
